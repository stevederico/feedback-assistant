{
  "name": "feedback-assistant",
  "private": false,
  "version": "3.2.0",
  "skateboardVersion": "3.5.0",
  "type": "module",
  "workspaces": [
    "backend",
    "widget"
  ],
  "scripts": {
    "start": "npm run front & npm run server & npm run widget",
    "front": "vite --force --mode development",
    "server": "npm run --workspace=backend start",
    "widget": "npm run --workspace=widget dev",
    "build": "vite build --mode production && npm run --workspace=widget build",
    "prod": "vite build --mode production && npm run --workspace=widget build",
    "install-all": "npm install && npm install --workspace=backend && npm install --workspace=widget"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@stevederico/skateboard-ui": "3.8.0",
    "@tanstack/react-table": "^8.21.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router": "7.15.0",
    "react-router-dom": "7.15.0",
    "recharts": "3.8.1",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.0",
    "@vitejs/plugin-react-swc": "4.3.0",
    "tailwindcss": "4.3.0",
    "vite": "7.3.3"
  }
}
